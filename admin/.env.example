# Takka web app (admin/). Copy to admin/.env — never commit real secrets.
# Existing hosting vars stay as they are on Render. The join-kitchen alerts
# below are optional: if both Telegram and the webhook are empty, a new lead
# is still saved and the admin "جديد" count still updates. Nothing is sent.

DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
UPLOADTHING_TOKEN=
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Optional. Free Telegram alert for each new /join-kitchen lead.
# Create a bot with @BotFather, message it (or add it to a group), then:
# TELEGRAM_BOT_TOKEN=123456:abc
# TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. POST JSON { event, lead } when a lead is created.
# JOIN_KITCHEN_ALERT_WEBHOOK_SECRET is sent as "Authorization: Bearer …" when set.
JOIN_KITCHEN_ALERT_WEBHOOK_URL=
JOIN_KITCHEN_ALERT_WEBHOOK_SECRET=
