# Takka web app (admin/). Copy to admin/.env — never commit real secrets.
# Existing hosting vars stay as they are on Render.

DATABASE_URL=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Cloudflare R2. Set these on BOTH Render services (TAKKA-admin and TAKKA-App).
# Endpoint: https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com  region: auto
# Public reads: ${R2_PUBLIC_URL}/<object key>
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=takka-media
R2_PUBLIC_URL=https://pub-35d18718f36741e68738b3fd193e189e.r2.dev

# Unused by new uploads. Leave it until old UploadThing images are copied
# from لوحة الإدارة → نقل الصور, then it can be removed.
UPLOADTHING_TOKEN=
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# In-app Android update prompt (GET /api/mobile/app-version).
# Leave all of these empty to disable the prompt. The app stays silent.
# MOBILE_APP_LATEST_VERSION=1.0.0
# MOBILE_APP_LATEST_BUILD=1
# MOBILE_APP_MIN_BUILD=1
# MOBILE_APP_DOWNLOAD_URL=https://github.com/<org>/<repo>/releases/download/v1.0.0/takka-1.0.0-1-universal.apk
# MOBILE_APP_RELEASE_NOTES_AR=

# Customer support WhatsApp. Exposed on GET /api/mobile/app-version.
# The app opens WhatsApp itself; the server does not send a message.
# Defaults to +201515327198 when unset or invalid.
# SUPPORT_WHATSAPP_NUMBER=+201515327198

# ---------------------------------------------------------------------------
# New /join-kitchen lead alerts
# Primary: email over SMTP (free with a Gmail account + App Password).
# Optional extras: Telegram bot and/or webhook.
# If none of these are set, the lead is still saved and the admin "جديد"
# count still updates. Mail failures never fail the public form.
# ---------------------------------------------------------------------------

# Recipient (defaults to takkaapp.eg@gmail.com when SMTP is configured).
JOIN_KITCHEN_ALERT_EMAIL_TO=takkaapp.eg@gmail.com

# Gmail SMTP (or any SMTP provider). Leave blank to skip email.
# Setup for Gmail:
# 1. Turn on 2-Step Verification for the Google account.
# 2. Open https://myaccount.google.com/apppasswords
# 3. Create an App Password for "Mail" / "Other" (e.g. Takka Render).
# 4. Paste the 16-character password into SMTP_PASS (no spaces).
# 5. On Render, set the vars below on the takka-app service.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE=true   # optional; 465 defaults to TLS, set false for 587
SMTP_USER=takkaapp.eg@gmail.com
SMTP_PASS=
SMTP_FROM=تكة <takkaapp.eg@gmail.com>

# Optional. Override the admin dashboard link in the email body.
# JOIN_KITCHEN_ALERT_ADMIN_URL=https://takka-admin.onrender.com

# Optional Telegram alert.
# Create a bot with @BotFather, message it (or add it to a group), then:
# TELEGRAM_BOT_TOKEN=123456:abc
# TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. POST JSON { event, lead } when a lead is created.
# JOIN_KITCHEN_ALERT_WEBHOOK_SECRET is sent as "Authorization: Bearer …" when set.
JOIN_KITCHEN_ALERT_WEBHOOK_URL=
JOIN_KITCHEN_ALERT_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Kitchen push (FCM). Optional. If unset, in-app Pusher notifications still
# work and the API skips push. See docs/fcm-setup.md.
# Use ONE of: the full service-account JSON, or the three fields below.
# ---------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...@....iam.gserviceaccount.com"}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional lock for GET/POST /api/cron/kitchen-acceptance.
# Leave unset: the endpoint stays open and idempotent, and /api/health (UptimeRobot)
# already runs the same sweep without this secret.
# CRON_SECRET=

# ---------------------------------------------------------------------------
# Sentry (optional). Free-plan error + light performance monitoring.
# Already set on Render as `Sentry_key` for TAKKA-admin and TAKKA-App.
# If missing, Sentry is fully disabled (no errors). Never commit a real DSN.
# Client bundle gets the DSN via next.config env mapping → NEXT_PUBLIC_SENTRY_DSN.
# No SENTRY_AUTH_TOKEN / source-map upload.
# ---------------------------------------------------------------------------
# Sentry_key=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
